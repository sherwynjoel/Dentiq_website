---
---

<section id="hero" aria-label="Hero">
  <!-- Background gradient overlay -->
  <div class="hero__bg"></div>
  <div class="hero__pattern"></div>

  <div class="hero__grid">
    <div class="hero__left">
      <h1 class="hero__heading">
        Dental Implants, Invisalign & TMJ Specialist <em>in Erode</em>
      </h1>
      <span class="section__label section__label--light">
        <svg
          width="12"
          height="12"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.5"
          aria-hidden="true"
          ><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"
          ></path><circle cx="12" cy="10" r="3"></circle></svg
        >
        Palayapalayam, Erode
      </span>
      <p class="hero__sub">
        Helping patients across Erode, Coimbatore, Tirupur, Salem and Namakkal
        Region comfort, confidence and quality of life through advanced implant,
        TMJ and smile care.
      </p>
      <div class="hero__actions">
        <a
          href="#contact"
          class="btn btn--primary"
          data-magnetic
          data-cursor-hover
        >
          Book Consultation
        </a>
        <a
          href="https://wa.me/918489488999"
          target="_blank"
          rel="noopener"
          class="btn btn--whatsapp"
          data-cursor-hover
        >
          <svg
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="currentColor"
            style="margin-right:6px;flex-shrink:0"
            ><path
              d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413Z"
            ></path></svg
          >
          WhatsApp Us
        </a>
      </div>

      <div class="hero__trust-bar">
        <span
          ><svg
            width="14"
            height="14"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            ><polyline points="20 6 9 17 4 12"></polyline></svg
          > Advanced Digital Dentistry</span
        >
        <span
          ><svg
            width="14"
            height="14"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            ><polyline points="20 6 9 17 4 12"></polyline></svg
          > Specialized TMJ Care</span
        >
        <span
          ><svg
            width="14"
            height="14"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            ><polyline points="20 6 9 17 4 12"></polyline></svg
          > Premium Sterilization</span
        >
        <span
          ><svg
            width="14"
            height="14"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            ><polyline points="20 6 9 17 4 12"></polyline></svg
          > Patient-Centered Comfort</span
        >
        <span
          ><svg
            width="14"
            height="14"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            ><polyline points="20 6 9 17 4 12"></polyline></svg
          > Advanced Sterilization & Infection Control</span
        >
      </div>

      <!-- Stat row -->
      <div class="hero__stats">
        <div class="hero__stat">
          <span class="hero__stat-num">23+</span>
          <span class="hero__stat-label">Years Experience</span>
        </div>
        <div class="hero__stat-divider"></div>
        <div class="hero__stat">
          <span class="hero__stat-num">10000+</span>
          <span class="hero__stat-label">Happy Families</span>
        </div>
        <div class="hero__stat-divider"></div>
        <div class="hero__stat">
          <span class="hero__stat-num"
            >4.9 <svg
              width="14"
              height="14"
              viewBox="0 0 24 24"
              fill="currentColor"
              style="display:inline-block; vertical-align:middle; margin-top:-4px;"
              ><path
                d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"
              ></path></svg
            ></span
          >
          <span class="hero__stat-label">Google Rating</span>
        </div>
        <div class="hero__stat-divider"></div>
        <div class="hero__stat">
          <span class="hero__stat-num">99%</span>
          <span class="hero__stat-label">Satisfaction</span>
        </div>
      </div>
    </div>

    <div class="hero__right">
      <div class="hero__image-wrapper">
        <img
          src="/dr-dilip.webp"
          alt="Dr. T. Balamurugan"
          class="hero__doctor-img"
        />
        <div class="hero__doctor-info" style="text-align: center;">
          <div style="color: var(--clr-navy); line-height: 1.2; margin-bottom: 2px;">
            <strong style="font-family: var(--font-heading); font-size: 0.95rem; display: inline;">Dr. T. Balamurugan</strong>
            <span style="display: inline; font-size: 0.72rem; font-weight: 600; margin-left: 2px; color: var(--clr-navy);">M.D.S.,F.I.C.O.I.,(USA),F.T.O.D.,(USA)</span>
          </div>
          <span style="font-size: 0.55rem; line-height: 1.3; margin-top: 2px;">Fellow International Congress of Oral Implantologists (USA)</span>
          <span style="font-size: 0.55rem; line-height: 1.3;">Fellow Temporo Mandibular Disorders, Oro-Facial Pain, Dental Sleep Medicine (USA)</span>
          <span style="font-size: 0.55rem; line-height: 1.3; margin-top: 2px;">Implantologist | Prosthodontist | Maxillofacial Prosthetist | BPS Consultant</span>
          <span style="font-size: 0.55rem; line-height: 1.3;">TMJ | Facial Pain | Dental Sleep Medicine Specialist</span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  #hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    align-items: center;
    padding: 10rem var(--gutter) 6rem !important;
    overflow: hidden;
    background-image: url('/hero-bg-1.webp');
    background-size: cover;
    background-position: center;
  }

  /* Background texture */
  .hero__bg {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(
        90deg,
        rgba(250, 246, 240, 0.94) 0%,
        rgba(250, 246, 240, 0.85) 44%,
        rgba(250, 246, 240, 0.56) 100%
      ),
      radial-gradient(
        ellipse 70% 70% at 50% 45%,
        rgba(250, 246, 240, 0.34) 0%,
        transparent 72%
      ),
      linear-gradient(to bottom, rgba(45, 53, 42, 0.03), rgba(45, 53, 42, 0.18));
    pointer-events: none;
    z-index: 0;
  }
  .hero__pattern {
    position: absolute;
    inset: 0;
    background-image: radial-gradient(
      rgba(78, 72, 50, 0.065) 1px,
      transparent 1px
    );
    background-size: 32px 32px;
    pointer-events: none;
  }

  .hero__grid {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column; /* Force vertical stacking on mobile */
    justify-content: center;
    align-items: center;
    max-width: var(--max-width);
    margin: 0 auto;
    width: 100%;
    text-align: center;
  }

  @media (min-width: 1025px) {
    .hero__grid {
      display: grid;
      grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
      gap: var(--space-12);
      align-items: center;
      text-align: left;
    }
  }

  /* Left */
  .hero__left {
    max-width: 860px;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  @media (min-width: 1025px) {
    .hero__left {
      align-items: flex-start;
      text-align: left;
    }
  }

  .hero__heading {
    font-family: var(--font-heading);
    font-size: clamp(2.2rem, 3.8vw, 3.2rem);
    font-weight: 700;
    line-height: 1.08;
    color: var(--clr-navy);
    margin-bottom: var(--space-2);
    letter-spacing: -0.01em;
    opacity: 0;
  }
  .hero__heading em {
    font-style: italic;
    color: var(--clr-gold-dark);
  }

  .hero__sub {
    font-size: var(--text-base);
    font-weight: 300;
    line-height: 1.7;
    color: var(--clr-text-dark);
    margin-bottom: var(--space-3);
    max-width: 64ch;
    opacity: 0;
  }

  .hero__actions {
    display: flex;
    justify-content: center;
    gap: var(--space-4);
    margin-bottom: var(--space-3);
    opacity: 0;
  }

  @media (min-width: 1025px) {
    .hero__actions {
      justify-content: flex-start;
    }
  }

  .btn--whatsapp {
    background: #25d366;
    color: #fff;
    padding: 12px 24px;
    border-radius: var(--radius-pill);
    font-weight: 600;
    font-size: var(--text-xs);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    display: inline-flex;
    align-items: center;
    transition: all 0.3s ease;
    border: none;
  }
  .btn--whatsapp:hover {
    background: #1ebe5d;
    box-shadow: var(--shadow-md);
    transform: translateY(-2px);
  }

  .hero__trust-bar {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-5);
    margin-bottom: var(--space-3);
    opacity: 0;
  }
  .hero__trust-bar span {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.7rem;
    font-weight: 600;
    color: var(--clr-navy);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }
  .hero__trust-bar span svg {
    color: var(--clr-gold-dark);
    flex-shrink: 0;
  }
  #nav.is-home-nav:not(.is-scrolled) ~ main .hero__trust-bar span {
    color: var(--clr-navy);
  }

  @media (min-width: 1025px) {
    .hero__trust-bar {
      justify-content: flex-start;
    }
  }
  @media (max-width: 500px) {
    .hero__trust-bar {
      gap: var(--space-2) var(--space-4);
    }
    .hero__trust-bar span {
      font-size: 0.65rem;
    }
  }

  .btn--free-consult {
    background: transparent;
    border: 1px solid rgba(78, 72, 50, 0.35);
    color: var(--clr-navy);
    padding: 12px 24px;
    border-radius: var(--radius-pill);
    font-weight: 600;
    font-size: var(--text-xs);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    display: inline-flex;
    align-items: center;
    transition: all 0.3s ease;
  }
  .btn--free-consult:hover {
    background: var(--clr-navy);
    color: var(--clr-white);
    box-shadow: var(--shadow-md);
  }

  .hero__trust-row {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-2);
    margin-bottom: var(--space-4);
    opacity: 0;
  }

  @media (min-width: 1025px) {
    .hero__trust-row {
      justify-content: flex-start;
    }
  }
  .hero__trust-row span {
    padding: 6px 12px;
    border: 1px solid rgba(78, 72, 50, 0.14);
    border-radius: var(--radius-pill);
    background: rgba(252, 250, 246, 0.72);
    color: var(--clr-navy);
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    backdrop-filter: blur(10px);
  }

  /* Stats row */
  .hero__stats {
    display: flex;
    align-items: center;
    gap: var(--space-6);
    flex-wrap: wrap;
    opacity: 0;
    padding: var(--space-4) var(--space-6);
    background: rgba(252, 250, 246, 0.88);
    border: 1px solid rgba(78, 72, 50, 0.12);
    border-radius: var(--radius-lg);
    backdrop-filter: blur(16px);
    box-shadow: 0 12px 48px rgba(78, 72, 50, 0.14);
  }
  .hero__stat {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2px;
    flex: 1;
    min-width: 80px;
  }
  .hero__stat-num {
    font-family: var(--font-body);
    font-size: var(--text-lg);
    font-weight: 700;
    color: var(--clr-navy);
    line-height: 1;
  }
  .hero__stat-label {
    font-size: 0.62rem;
    font-weight: 400;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--clr-text-mid);
    text-align: center;
  }
  .hero__stat-divider {
    width: 1px;
    height: 28px;
    background: var(--clr-light-gray);
    flex-shrink: 0;
  }

  /* On short desktop viewports, centering pulls content above the nav — anchor it instead */
  @media (min-width: 1025px) and (max-height: 780px) {
    #hero {
      align-items: flex-start;
    }
  }

  /* Responsive */
  @media (max-width: 1024px) {
    #hero {
      align-items: flex-start;
      padding-top: 10rem;
      height: auto;
      min-height: auto;
      padding-bottom: 8rem;
    }
    .hero__heading {
      font-size: 3.5rem;
      line-height: 1.1;
    }
    .hero__sub {
      font-size: 1.1rem;
    }
  }
  @media (max-width: 768px) {
    .hero__heading {
      font-size: 2.8rem;
    }
    .hero__stats {
      padding: var(--space-6);
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: var(--space-6) var(--space-4);
    }
    .hero__stat-divider {
      display: none;
    }
  }
  @media (max-width: 500px) {
    #hero {
      padding-top: 8rem;
    }
    .hero__heading {
      font-size: 2.2rem;
      letter-spacing: -0.01em;
    }
    .hero__sub {
      font-size: 0.95rem;
      line-height: 1.7;
      margin-bottom: var(--space-8);
    }
    .hero__stat-num {
      font-size: 1.4rem;
    }
    .hero__stat-label {
      font-size: 0.65rem;
    }
    .hero__trust-row {
      justify-content: center;
      gap: 8px;
    }
    .hero__trust-row span {
      font-size: 0.6rem;
      padding: 5px 10px;
    }
    .hero__actions {
      flex-direction: column;
      width: 100%;
    }
    .hero__actions .btn {
      width: 100%;
      text-align: center;
      justify-content: center;
    }
  }

  .hero__right {
    display: flex;
    justify-content: center;
    align-items: center;
    width: 100%;
    margin-top: var(--space-8);
    margin-bottom: var(--space-4);
  }
  @media (min-width: 1025px) {
    .hero__right {
      justify-content: flex-end;
      align-items: center;
      width: 100%;
      margin-top: 0.5rem; /* Balanced parallel alignment alongside the grid margin */
      margin-bottom: 0;
    }
  }
  .hero__image-wrapper {
    position: relative;
    width: 100%;
    max-width: 300px;
    aspect-ratio: 2.8 / 4;
    border-radius: var(--radius-xl);
    overflow: hidden;
    box-shadow:
      var(--shadow-lg),
      0 20px 48px rgba(45, 53, 42, 0.22);
    border: 2px solid var(--clr-gold);
    background: var(--clr-off-white);
  }
  .hero__doctor-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.6s var(--ease-out-expo);
  }
  .hero__image-wrapper:hover .hero__doctor-img {
    transform: scale(1.04);
  }
  .hero__doctor-info {
    position: absolute;
    bottom: var(--space-4);
    left: var(--space-4);
    right: var(--space-4);
    background: rgba(250, 246, 240, 0.94);
    backdrop-filter: blur(12px);
    border: 1px solid rgba(206, 196, 167, 0.35);
    padding: var(--space-3) var(--space-4);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-md);
    text-align: left;
  }
  .hero__doctor-info strong {
    display: block;
    font-family: var(--font-heading);
    font-size: 0.95rem;
    color: var(--clr-navy);
    line-height: 1.2;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .hero__doctor-info span {
    display: block;
    font-size: 0.72rem;
    color: var(--clr-text-mid);
    margin-top: 2px;
    font-weight: 500;
  }
</style>

<script>
  import gsap from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  window.addEventListener("loader:complete", () => {
    const tl = gsap.timeline({ defaults: { ease: "power4.out" } });

    tl.to(".section__label", { opacity: 1, y: 0, duration: 0.5 })
      .to(".hero__heading", { opacity: 1, y: 0, duration: 0.6 }, "-=0.3")
      .to(".hero__sub", { opacity: 1, duration: 0.5 }, "-=0.4")
      .to(".hero__actions", { opacity: 1, duration: 0.5 }, "-=0.4")
      .to(".hero__trust-bar", { opacity: 1, duration: 0.45 }, "-=0.4")
      .to(".hero__trust-row", { opacity: 1, duration: 0.45 }, "-=0.35")
      .to(".hero__stats", { opacity: 1, y: 0, duration: 0.5 }, "-=0.4")
      .to(
        ".hero__image-wrapper",
        { opacity: 1, x: 0, rotateY: 0, duration: 1 },
        "-=0.8",
      )
      .to(".hero__doctor-info", { opacity: 1, y: 0, duration: 0.6 }, "-=0.4")
      .to(".hero__scroll-hint", { opacity: 1, duration: 0.4 }, "-=0.2");
  });

  // Initial state
  gsap.set([".hero__heading", ".hero__stats"], { y: 40 });
  gsap.set(".hero__image-wrapper", { opacity: 0, x: 30, rotateY: -10 });
  gsap.set(".hero__doctor-info", { opacity: 0, y: 20 });

  // Parallax on scroll
  ScrollTrigger.create({
    trigger: "#hero",
    start: "top top",
    end: "bottom top",
    onUpdate(self) {
      gsap.set(".hero__bg", { y: self.progress * 80 });
    },
  });
</script>
