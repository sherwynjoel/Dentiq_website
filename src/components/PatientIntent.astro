---
const cards = [
  {
    problem: "I Have Missing Teeth",
    solution: "Dental Implants",
    desc: "Permanent, natural-looking tooth replacement that restores full chewing function and confidence.",
    href: "/implants-tmj-erode#implants",
    icon: `<svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4"><path d="M12 2C9 2 6 4.5 6 7.5c0 1.8 1 3.3 2 4.5l.8 4h6.4l.8-4c1-1.2 2-2.7 2-4.5C18 4.5 15 2 12 2z"/><path d="M9.5 22h5M12 12v4"/></svg>`,
    color: "var(--clr-gold)"
  },
  {
    problem: "I Have Jaw Pain or Headaches",
    solution: "TMJ Centre",
    desc: "Specialist diagnosis and treatment for TMJ disorders, orofacial pain, clicking jaw and related headaches.",
    href: "/implants-tmj-erode#tmj",
    icon: `<svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4"><circle cx="12" cy="8" r="5"/><path d="M8 13c-2.5 1-4 3-4 5h16c0-2-1.5-4-4-5"/><path d="M10 8h4M12 6v4"/></svg>`,
    color: "#e8a0a0"
  },
  {
    problem: "I Want Straighter Teeth",
    solution: "Clear Aligners",
    desc: "Invisible, removable aligners to straighten crowded or misaligned teeth — no metal, no discomfort.",
    href: "/clear-aligners-erode",
    icon: `<svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4"><rect x="4" y="7" width="16" height="10" rx="3"/><path d="M8 7V5a2 2 0 0 1 4 0v2M12 7v2m4-2V5a2 2 0 0 0-4 0"/></svg>`,
    color: "#a0c8e8"
  },
  {
    problem: "I Need Full Mouth Rehabilitation",
    solution: "Full Mouth Reconstruction",
    desc: "Comprehensive restoration combining implants, crowns, bridges and smile design for complete oral rehabilitation.",
    href: "/treatments/prosthodontics",
    icon: `<svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4"><path d="M12 22s-8-4.5-8-11.8A8 8 0 0 1 12 2a8 8 0 0 1 8 8.2C20 17.5 12 22 12 22z"/><path d="M9 12l2 2 4-4"/></svg>`,
    color: "#a8d8a8"
  }
];
---

<section id="patient-intent" class="intent">
  <div class="intent__inner">
    <div class="intent__header">
      <span class="section__label">Find Your Treatment</span>
      <h2 class="intent__heading">What Brings You <em>Here?</em></h2>
      <p class="intent__sub">Choose your concern — we'll guide you to the right specialist and solution.</p>
    </div>

    <div class="intent__grid">
      {cards.map((card) => (
        <a href={card.href} class="intent-card" data-cursor-hover>
          <div class="intent-card__icon" style={`--card-color: ${card.color}`}>
            <div set:html={card.icon}></div>
          </div>
          <div class="intent-card__body">
            <p class="intent-card__problem">{card.problem}</p>
            <h3 class="intent-card__solution">{card.solution}</h3>
            <p class="intent-card__desc">{card.desc}</p>
          </div>
          <div class="intent-card__cta">
            Learn More
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .intent {
    background: var(--clr-navy);
    padding: var(--space-32) var(--gutter);
  }
  .intent__inner {
    max-width: var(--max-width);
    margin: 0 auto;
  }
  .intent__header {
    text-align: center;
    margin-bottom: var(--space-16);
    max-width: 640px;
    margin-left: auto;
    margin-right: auto;
  }
  .intent__heading {
    font-family: var(--font-heading);
    font-size: var(--text-3xl);
    font-weight: 700;
    color: var(--clr-white);
    line-height: 1.1;
    margin-bottom: var(--space-4);
  }
  .intent__heading em { font-style: italic; color: var(--clr-gold); }
  .intent__sub {
    font-size: var(--text-base);
    color: rgba(255,255,255,0.65);
    font-weight: 300;
    line-height: 1.6;
  }

  .intent__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-6);
  }

  .intent-card {
    background: rgba(255,255,255,0.05);
    border: 1px solid rgba(255,255,255,0.1);
    border-radius: var(--radius-xl);
    padding: var(--space-8);
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
    text-decoration: none;
    transition: background 0.4s ease, border-color 0.4s ease, transform 0.4s var(--ease-out-expo);
  }
  .intent-card:hover {
    background: rgba(255,255,255,0.1);
    border-color: var(--clr-gold);
    transform: translateY(-8px);
  }

  .intent-card__icon {
    width: 72px;
    height: 72px;
    border-radius: var(--radius-lg);
    background: rgba(255,255,255,0.08);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--card-color, var(--clr-gold));
    transition: background 0.3s ease;
  }
  .intent-card:hover .intent-card__icon {
    background: rgba(255,255,255,0.14);
  }

  .intent-card__body { flex: 1; }
  .intent-card__problem {
    font-size: 0.65rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: rgba(255,255,255,0.45);
    margin-bottom: var(--space-2);
  }
  .intent-card__solution {
    font-family: var(--font-heading);
    font-size: var(--text-lg);
    font-weight: 700;
    color: var(--clr-white);
    margin-bottom: var(--space-3);
    line-height: 1.2;
  }
  .intent-card__desc {
    font-size: var(--text-sm);
    color: rgba(255,255,255,0.6);
    line-height: 1.65;
    font-weight: 300;
  }

  .intent-card__cta {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.68rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--clr-gold);
    margin-top: auto;
    transition: gap 0.3s ease;
  }
  .intent-card:hover .intent-card__cta { gap: 10px; }

  @media (max-width: 1100px) { .intent__grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 600px)  { .intent__grid { grid-template-columns: 1fr; } }
</style>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);

  gsap.from('.intent__header', {
    scrollTrigger: { trigger: '#patient-intent', start: 'top 82%', once: true },
    y: 40, opacity: 0, duration: 0.8, ease: 'power3.out'
  });
  gsap.from('.intent-card', {
    scrollTrigger: { trigger: '.intent__grid', start: 'top 85%', once: true },
    y: 40, opacity: 0, stagger: 0.12, duration: 0.9, ease: 'power3.out'
  });

  // Fix cards stuck invisible after browser back-navigation (bfcache restore)
  window.addEventListener('pageshow', (e) => {
    if (e.persisted) {
      gsap.set('.intent-card, .intent__header', { clearProps: 'all' });
      ScrollTrigger.refresh();
    }
  });
</script>
