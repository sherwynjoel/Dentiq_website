---
const images = [
  {
    src: "/IMG20230610160409.jpg",
    alt: "Dr. T. Balamurugan conducting hands-on Zygomatic Implant training session",
    caption: "Hands-On Clinical Session"
  },
  {
    src: "/IMG_2603.JPG",
    alt: "Certificate presentation at Advanced Zygomatic Implant course",
    caption: "Awarding Certificates"
  },
  {
    src: "/IMG_2607.JPG",
    alt: "Dr. Balamurugan and Dr. Satish presenting certificates to course participants",
    caption: "Graduation Ceremony"
  },
  {
    src: "/IMG_2613.JPG",
    alt: "Group photo of participants at DentiQ Advanced Implant Training Course",
    caption: "Course Participants"
  }
];
---

<section id="training" class="training">
  <div class="training__inner">

    <div class="training__header">
      <span class="section__label section__label--light">Doctor Education Programme</span>
      <h2 class="training__heading">Training the Next Generation of <em>Implant Specialists</em></h2>
      <p class="training__sub">
        Dr. T. Balamurugan and Dr. Satish conduct advanced hands-on courses on Zygomatic Implants and Pterygoid Implants — exclusively for qualified dental professionals across India.
      </p>
    </div>

    <div class="training__grid">
      <div class="training__gallery">
        {images.map((img, i) => (
          <div class={`training__img-wrap training__img-wrap--${i}`}>
            <img src={img.src} alt={img.alt} loading="lazy" />
            <span class="training__img-caption">{img.caption}</span>
          </div>
        ))}
      </div>

      <div class="training__info">
        <div class="training__badge">
          <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M22 10v6M2 10l10-5 10 5-10 5z"/><path d="M6 12v5c3 3 9 3 12 0v-5"/></svg>
          <span>Advanced Implant Training</span>
        </div>

        <h3>Courses Conducted by <strong>Dr. Balamurugan &amp; Dr. Satish</strong></h3>

        <ul class="training__topics">
          <li>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
            Advanced Zygomatic Dental Implants
          </li>
          <li>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
            Pterygoid Implant Techniques
          </li>
          <li>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
            Hands-On Clinical Training
          </li>
          <li>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
            Certificate Courses for Dental Professionals
          </li>
          <li>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
            Live Patient Demonstrations
          </li>
        </ul>

        <p class="training__note">
          A doctor trusted to train other specialists brings that same depth of mastery to every patient in the chair.
        </p>

        <a href="https://wa.me/918489488999?text=I%20am%20interested%20in%20the%20Advanced%20Implant%20Training%20Course" target="_blank" rel="noopener" class="btn btn--gold training__cta" data-cursor-hover>
          Enquire About Training
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </a>
      </div>
    </div>

  </div>
</section>

<style>
  .training {
    background: var(--clr-navy);
    padding: var(--space-32) var(--gutter);
    position: relative;
    overflow: hidden;
  }
  .training::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image: radial-gradient(rgba(206,196,167,0.07) 1px, transparent 1px);
    background-size: 32px 32px;
    pointer-events: none;
  }

  .training__inner {
    max-width: var(--max-width);
    margin: 0 auto;
    position: relative;
    z-index: 1;
  }

  .training__header {
    text-align: center;
    max-width: 720px;
    margin: 0 auto var(--space-16);
  }
  .training__heading {
    font-family: var(--font-heading);
    font-size: var(--text-3xl);
    font-weight: 700;
    color: var(--clr-white);
    line-height: 1.1;
    margin-bottom: var(--space-5);
  }
  .training__heading em { font-style: italic; color: var(--clr-gold); }
  .training__sub {
    font-size: var(--text-base);
    color: rgba(255,255,255,0.65);
    font-weight: 300;
    line-height: 1.7;
  }

  /* Grid: gallery left, info right */
  .training__grid {
    display: grid;
    grid-template-columns: 1fr 420px;
    gap: var(--space-12);
    align-items: center;
  }

  /* Photo gallery — 2×2 */
  .training__gallery {
    display: grid;
    grid-template-columns: 1fr 1fr;
    grid-template-rows: 1fr 1fr;
    gap: var(--space-3);
    aspect-ratio: 1.1 / 1;
  }
  .training__img-wrap {
    position: relative;
    overflow: hidden;
    border-radius: var(--radius-lg);
    border: 1px solid rgba(255,255,255,0.1);
  }
  .training__img-wrap img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s ease;
    display: block;
  }
  .training__img-wrap:hover img { transform: scale(1.06); }

  .training__img-caption {
    position: absolute;
    bottom: 0; left: 0; right: 0;
    background: linear-gradient(to top, rgba(45,53,42,0.85), transparent);
    color: rgba(255,255,255,0.9);
    font-size: 0.62rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    padding: var(--space-4) var(--space-4) var(--space-3);
  }

  /* Info panel */
  .training__badge {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    background: rgba(206,196,167,0.12);
    border: 1px solid rgba(206,196,167,0.25);
    border-radius: var(--radius-pill);
    padding: var(--space-2) var(--space-5);
    margin-bottom: var(--space-6);
    color: var(--clr-gold);
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
  }

  .training__info h3 {
    font-family: var(--font-heading);
    font-size: var(--text-xl);
    font-weight: 600;
    color: var(--clr-white);
    line-height: 1.3;
    margin-bottom: var(--space-7);
  }
  .training__info h3 strong { color: var(--clr-gold); font-weight: 700; }

  .training__topics {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    margin-bottom: var(--space-8);
  }
  .training__topics li {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    font-size: var(--text-sm);
    color: rgba(255,255,255,0.8);
    font-weight: 400;
  }
  .training__topics li svg { color: var(--clr-gold); flex-shrink: 0; }

  .training__note {
    font-size: var(--text-sm);
    color: rgba(255,255,255,0.45);
    font-weight: 300;
    line-height: 1.65;
    font-style: italic;
    border-left: 2px solid var(--clr-gold);
    padding-left: var(--space-4);
    margin-bottom: var(--space-8);
  }

  .btn--gold {
    background: var(--clr-gold);
    color: var(--clr-navy);
    padding: 14px 28px;
    border-radius: var(--radius-pill);
    font-size: var(--text-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    transition: background 0.3s ease, transform 0.3s ease;
  }
  .btn--gold:hover {
    background: var(--clr-gold-light);
    transform: translateY(-2px);
  }

  @media (max-width: 1100px) {
    .training__grid { grid-template-columns: 1fr; }
    .training__gallery { aspect-ratio: 16/9; grid-template-columns: repeat(4, 1fr); grid-template-rows: 1fr; }
  }
  @media (max-width: 700px) {
    .training__gallery { grid-template-columns: repeat(2, 1fr); grid-template-rows: repeat(2, 1fr); aspect-ratio: 1/1; }
  }
</style>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);

  gsap.from('.training__header', {
    scrollTrigger: { trigger: '#training', start: 'top 82%' },
    y: 40, opacity: 0, duration: 0.8, ease: 'power3.out'
  });
  gsap.from('.training__img-wrap', {
    scrollTrigger: { trigger: '.training__gallery', start: 'top 85%' },
    y: 30, opacity: 0, stagger: 0.1, duration: 0.8, ease: 'power3.out'
  });
  gsap.from('.training__info > *', {
    scrollTrigger: { trigger: '.training__info', start: 'top 85%' },
    y: 30, opacity: 0, stagger: 0.1, duration: 0.7, ease: 'power3.out'
  });
</script>
