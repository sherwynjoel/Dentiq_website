---
const testimonials = [
  { text: "Excellent experience at Dentiq. The facility is incredibly clean, modern, and well organized. Dr. Mr. Balamurugan is a true professional — very patient, highly skilled, and took the time to explain my mother's treatment in a way we could easily understand. A huge thanks for the warm hospitality and efficient service we received throughout our visit. It's rare to find a place where everyone is so dedicated to patient care. Highly recommended.", name: "Rama Chandran", city: "Erode", stars: 5 },
  { text: "I had a very pleasant experience with Dr. Bala when I came for root canal and crown as well for the pre molar tooth extraction. The overall procedure is painless and Doctor explained the conditions and treatment options in brief. Overall, I highly recommend Dr. Bala for all dental treatments.", name: "Yuvaraj Deivasigamani", city: "Erode", stars: 5 },
  { text: "Myself done Dental Implant Treatment in Dentiq Hospital. Dr. Balamurugan Sir explained all the things so kindly and made me comfortable. I strongly recommend Doctor Balamurugan Sir to all my Friends and Relatives.", name: "Guruvayurappan B", city: "Erode", stars: 5 },
  { text: "The Doctor's effort to know the root cause of my right side lower jaw pain really made me get a surprise that till date I have not experienced in my life time. He patiently explained each and everything until I got a clear picture of my jaw problem. My heartfelt thanks to Dr. Balamurugan.", name: "Murugesan Elangovan", city: "Erode", stars: 5 },
  { text: "My concerns were addressed properly and I was given a perfect solution which was not the case with my previous dentists. I am happy for the treatment. Their approach was very straightforward and they take enough time to address the issue and explain all possible solutions, and let us choose the one feasible for us. For any dental issues do visit this place. The ambience was very good and hygienic.", name: "Vidhya Elangovan", city: "Erode", stars: 5 },
  { text: "Dr Bala was amazing while taking care of his patients and he is replying gently for the queries given to him. Am a NRI with gaps in the teeth and I approached Dentiq, they provided the amazing solution — Invisible Aligners — within a short period of time and the service provided by the people around the clinic was quite good.", name: "Vinothkumar Palaniappan", city: "Erode", stars: 5 },
];
---

<section id="testimonials" class="testimonials">
  <div class="testimonials__inner">
    <div class="testimonials__header">
      <span class="section__label section__label--light">Patient Stories</span>
      <h2 class="testimonials__heading">What Our <em>Patients Say</em></h2>
      <p class="testimonials__sub">
        401 verified Google reviews &nbsp;·&nbsp; 4.8 <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" style="display:inline-block; vertical-align:middle; margin-top:-2px;"><path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg> average rating
      </p>
    </div>

    <div class="testi-grid">
      {testimonials.map((t, i) => (
        <blockquote class={`testi-card ${i === 0 ? 'testi-card--featured' : ''}`}>
          <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 4px;">
            <div class="testi-card__stars" aria-label="5 stars" style="color: #fbbc04;">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
            </div>
            <div class="testi-card__google-logo" title="Verified Google Review">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 48 48" width="20px" height="20px">
                <path fill="#FFC107" d="M43.611,20.083H42V20H24v8h11.303c-1.649,4.657-6.08,8-11.303,8c-6.627,0-12-5.373-12-12c0-6.627,5.373-12,12-12c3.059,0,5.842,1.154,7.961,3.039l5.657-5.657C34.046,6.053,29.268,4,24,4C12.955,4,4,12.955,4,24c0,11.045,8.955,20,20,20c11.045,0,20-8.955,20-20C44,22.659,43.862,21.35,43.611,20.083z"/>
                <path fill="#FF3D00" d="M6.306,14.691l6.571,4.819C14.655,15.108,18.961,12,24,12c3.059,0,5.842,1.154,7.961,3.039l5.657-5.657C34.046,6.053,29.268,4,24,4C16.318,4,9.656,8.337,6.306,14.691z"/>
                <path fill="#4CAF50" d="M24,44c5.166,0,9.86-1.977,13.409-5.192l-6.19-5.238C29.211,35.091,26.715,36,24,36c-5.202,0-9.619-3.317-11.283-7.946l-6.522,5.025C9.505,39.556,16.227,44,24,44z"/>
                <path fill="#1976D2" d="M43.611,20.083H42V20H24v8h11.303c-0.792,2.237-2.231,4.166-4.087,5.571c0.001-0.001,0.002-0.001,0.003-0.002l6.19,5.238C36.971,39.205,44,34,44,24C44,22.659,43.862,21.35,43.611,20.083z"/>
              </svg>
            </div>
          </div>
          <p class="testi-card__text">"{t.text}"</p>
          <footer class="testi-card__footer">
            <div class="testi-card__avatar">
              {t.name.charAt(0)}
            </div>
            <div>
              <cite class="testi-card__name">{t.name}</cite>
              <span class="testi-card__city">{t.city}</span>
            </div>
          </footer>
        </blockquote>
      ))}
    </div>

    <div class="testimonials__cta">
      <a
        href="https://www.google.com/maps/search/?api=1&query=DentiQ+Superspeciality+Dental+Implant+TMJ+Headache+Sleep+Medicine+Clinic+Erode"
        target="_blank"
        rel="noopener noreferrer"
        class="btn btn--primary"
        data-cursor-hover
      >
        Read All Reviews on Google <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="display:inline-block; vertical-align:middle; margin-left:4px;"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
      </a>
    </div>
  </div>
</section>

<style>
  .testimonials {
    background: var(--clr-white);
    padding: var(--space-32) var(--gutter);
  }

  .testimonials__inner {
    max-width: var(--max-width);
    margin: 0 auto;
  }

  .testimonials__header {
    text-align: center;
    margin-bottom: var(--space-16);
    max-width: 600px;
    margin-left: auto;
    margin-right: auto;
  }

  .testimonials__heading {
    font-family: var(--font-heading);
    font-size: var(--text-3xl);
    font-weight: 600;
    color: var(--clr-navy);
    line-height: 1.2;
    margin-bottom: var(--space-4);
  }
  .testimonials__heading em {
    font-style: italic;
    color: var(--clr-gold-dark);
  }

  .testimonials__sub {
    font-size: var(--text-sm);
    font-weight: 400;
    color: var(--clr-text-mid);
    letter-spacing: 0.06em;
  }

  .testi-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-5);
    margin-bottom: var(--space-12);
  }

  .testi-card {
    background: var(--clr-off-white);
    border: 1px solid var(--clr-light-gray);
    border-radius: var(--radius-lg);
    padding: var(--space-8);
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
    height: 100%;
    transition:
      background 0.35s ease,
      border-color 0.35s ease,
      transform 0.35s var(--ease-out-expo);
  }
  .testi-card:hover {
    background: var(--clr-white);
    border-color: var(--clr-gold);
    transform: translateY(-6px);
    box-shadow: var(--shadow-md);
  }

  .testi-card--featured {
    background: var(--clr-gold-pale);
    border-color: var(--clr-gold);
    grid-row: span 1;
  }
  .testi-card--featured:hover {
    background: var(--clr-white);
  }
  .testi-card--featured .testi-card__stars { color: var(--clr-gold-dark); }
  .testi-card--featured .testi-card__text { color: var(--clr-navy); }
  .testi-card--featured .testi-card__name { color: var(--clr-navy); }
  .testi-card--featured .testi-card__city { color: var(--clr-gold-dark); }
  .testi-card--featured .testi-card__avatar {
    background: var(--clr-navy);
    color: var(--clr-white);
  }

  .testi-card__stars {
    color: var(--clr-gold-dark);
    font-size: var(--text-sm);
    letter-spacing: 3px;
  }

  .testi-card__text {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-style: italic;
    font-weight: 300;
    line-height: 1.8;
    color: var(--clr-text-body);
    flex: 1;
  }

  .testi-card__footer {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .testi-card__avatar {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: var(--clr-gold-pale);
    border: 1px solid var(--clr-gold-pale);
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-heading);
    font-size: var(--text-base);
    font-weight: 600;
    color: var(--clr-navy);
    flex-shrink: 0;
  }

  .testi-card__name {
    display: block;
    font-style: normal;
    font-size: var(--text-xs);
    font-weight: 700;
    color: var(--clr-navy);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin-bottom: 2px;
  }

  .testi-card__city {
    font-size: var(--text-xs);
    font-weight: 300;
    color: var(--clr-text-mid);
    opacity: 0.8;
    letter-spacing: 0.06em;
  }

  .testimonials__cta {
    text-align: center;
    margin-top: var(--space-4);
  }

  @media (max-width: 900px) {
    .testi-grid { grid-template-columns: 1fr; max-width: 540px; margin-left: auto; margin-right: auto; }
  }
  @media (max-width: 600px) {
    .testi-grid { grid-template-columns: 1fr; }
  }
</style>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  gsap.from('.testimonials__header', {
    scrollTrigger: { trigger: '#testimonials', start: 'top 82%' },
    y: 30, opacity: 0, duration: 1, ease: 'power3.out',
  });
  gsap.from('.testi-card', {
    scrollTrigger: { trigger: '.testi-grid', start: 'top 85%' },
    y: 40, opacity: 0, stagger: 0.1, duration: 0.9, ease: 'power3.out',
  });
</script>
