---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Cursor from '../components/Cursor.astro';
import Contact from '../components/Contact.astro';

const symptoms = [
  "Jaw Pain", "Clicking or Popping Sounds", "Headaches", "Ear Pain or Fullness",
  "Neck Pain", "Difficulty Opening Mouth", "Facial Pain", "Teeth Grinding"
];

const steps = [
  { num: "01", title: "Comprehensive Assessment", desc: "Detailed history, pain mapping, and jaw function evaluation to understand your specific condition." },
  { num: "02", title: "Specialist Diagnosis", desc: "Advanced imaging and clinical examination to identify the exact cause — not just treat the symptoms." },
  { num: "03", title: "Personalised Treatment Plan", desc: "A structured plan tailored to your condition — from splint therapy to minimally invasive procedures." },
  { num: "04", title: "Follow-up & Monitoring", desc: "Regular reviews to track your progress and adjust treatment for lasting relief." }
];

const faqs = [
  { q: "What is TMJ disorder?", a: "TMJ (Temporomandibular Joint) disorder refers to a group of conditions causing pain and dysfunction in the jaw joint and surrounding muscles. It can cause jaw pain, headaches, clicking sounds, and difficulty opening or closing the mouth." },
  { q: "Why is TMJ often misdiagnosed?", a: "TMJ symptoms like headaches and ear pain overlap with many other conditions. Without specialized knowledge, it's commonly treated as migraine, ear infection or cervical pain — leaving the root cause unaddressed." },
  { q: "What treatments are available?", a: "Treatment ranges from conservative approaches (splint therapy, physiotherapy, medication) to minimally invasive procedures depending on severity. Dr. Balamurugan will recommend the most appropriate option after evaluation." },
  { q: "How long does treatment take?", a: "Duration varies by severity. Many patients experience significant relief within weeks of starting the right treatment. A proper diagnosis first is the most important step." },
  { q: "Do you see patients from outside Erode?", a: "Yes. We regularly see patients from Coimbatore, Tirupur, Salem, Namakkal and beyond. Many travel specifically for Dr. Balamurugan's TMJ expertise." }
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(f => ({
    "@type": "Question",
    "name": f.q,
    "acceptedAnswer": { "@type": "Answer", "text": f.a }
  }))
};
---

<BaseLayout
  title="TMJ Treatment in Erode | Jaw Pain & Orofacial Pain Specialist | DentiQ"
  description="Specialist TMJ evaluation and treatment in Erode. Dr. T. Balamurugan holds USA fellowship credentials in TMJ & Orofacial Pain. Serving Erode, Coimbatore, Salem, Tirupur, Namakkal."
  pageSchema={faqSchema}
>
  <Cursor />
  <Nav />
  <main>

    <!-- HERO -->
    <section class="lp-hero">
      <div class="lp-hero__bg"></div>
      <div class="lp-hero__content">
        <span class="section__label section__label--light">DentiQ TMJ Centre · Erode</span>
        <h1 class="lp-hero__heading">TMJ Specialist for Jaw Pain, Headaches <em>&amp; Facial Pain</em></h1>
        <p class="lp-hero__sub">
          Comprehensive TMJ evaluation and personalised treatment plans — by Dr. T. Balamurugan, M.D.S., F.T.O.D.(USA), one of Tamil Nadu's few fellowship-trained TMJ specialists. Serving patients from Erode, Coimbatore, Tirupur, Salem and Namakkal.
        </p>
        <div class="lp-hero__ctas">
          <a href="#contact" class="btn btn--primary">Book TMJ Consultation</a>
          <a href="https://wa.me/918489488999" target="_blank" rel="noopener" class="btn btn--whatsapp">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" style="margin-right:6px"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413Z"/></svg>
            WhatsApp Us
          </a>
        </div>
      </div>
    </section>

    <!-- SYMPTOMS -->
    <section class="lp-section lp-section--light">
      <div class="lp-container">
        <div class="lp-header">
          <span class="section__label">Common Signs</span>
          <h2 class="lp-heading">Do You Experience <em>Any of These?</em></h2>
          <p class="lp-sub">If you have one or more of these symptoms, a TMJ specialist evaluation may be the answer you've been looking for.</p>
        </div>
        <div class="symptoms-grid">
          {symptoms.map(s => (
            <div class="symptom-item">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
              <span>{s}</span>
            </div>
          ))}
        </div>
        <div class="misdiagnosis-box">
          <strong>Most TMJ cases are misdiagnosed as migraines, ear infections or cervical pain.</strong>
          A correct diagnosis from a specialist is the first and most important step to lasting relief.
        </div>
      </div>
    </section>

    <!-- HOW WE EVALUATE -->
    <section class="lp-section lp-section--dark">
      <div class="lp-container">
        <div class="lp-header">
          <span class="section__label section__label--light">Our Process</span>
          <h2 class="lp-heading lp-heading--light">How We Evaluate <em>TMJ Problems</em></h2>
        </div>
        <div class="steps-grid">
          {steps.map(s => (
            <div class="step-card">
              <span class="step-num">{s.num}</span>
              <h3>{s.title}</h3>
              <p>{s.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- DOCTOR CREDENTIALS -->
    <section class="lp-section lp-section--light">
      <div class="lp-container lp-credentials">
        <div class="lp-credentials__text">
          <span class="section__label">Your Specialist</span>
          <h2 class="lp-heading">Dr. T. Balamurugan <em>MDS, F.I.C.O.I.(USA), F.T.O.D.(USA)</em></h2>
          <p>Dr. Balamurugan is a Fellow of the Temporo Mandibular Disorders, Oro-Facial Pain &amp; Dental Sleep Medicine (USA) — making him one of the very few specialists in Tamil Nadu with dedicated, internationally certified TMJ training.</p>
          <ul class="cred-list">
            <li>Fellow International Congress of Oral Implantologists (USA)</li>
            <li>Fellow Temporo Mandibular Disorders &amp; Orofacial Pain (USA)</li>
            <li>Implantologist · Prosthodontist · Maxillofacial Prosthetist</li>
            <li>TMJ · Facial Pain · Dental Sleep Medicine Specialist</li>
          </ul>
          <a href="#contact" class="btn btn--primary" style="margin-top: 2rem; display: inline-block;">Book TMJ Evaluation</a>
        </div>
        <div class="lp-credentials__img">
          <img src="/dr-dilip.webp" alt="Dr. T. Balamurugan — TMJ Specialist Erode" />
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="lp-section lp-section--off">
      <div class="lp-container">
        <div class="lp-header">
          <span class="section__label">Common Questions</span>
          <h2 class="lp-heading">Frequently Asked <em>Questions</em></h2>
        </div>
        <div class="faq-list">
          {faqs.map(f => (
            <details class="faq-item">
              <summary>{f.q}</summary>
              <p>{f.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <!-- FINAL CTA -->
    <section class="lp-cta">
      <div class="lp-container lp-cta__inner">
        <h2>Get the Right Diagnosis <em>Before Choosing Treatment</em></h2>
        <p>Book a specialist TMJ evaluation with Dr. Balamurugan and take the first step toward lasting relief from jaw pain, headaches and facial pain.</p>
        <div class="lp-cta__btns">
          <a href="#contact" class="btn btn--primary">Book Consultation</a>
          <a href="https://wa.me/918489488999" target="_blank" rel="noopener" class="btn btn--whatsapp">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" style="margin-right:6px"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413Z"/></svg>
            WhatsApp
          </a>
        </div>
      </div>
    </section>

    <Contact />
  </main>
  <Footer />
</BaseLayout>

<style>
  .lp-container { max-width: var(--max-width); margin: 0 auto; padding: 0 var(--gutter); }
  .lp-header { text-align: center; margin-bottom: var(--space-12); max-width: 700px; margin-left: auto; margin-right: auto; }
  .lp-heading { font-family: var(--font-heading); font-size: clamp(1.8rem, 3vw, 2.6rem); font-weight: 700; color: var(--clr-navy); line-height: 1.15; margin-bottom: var(--space-4); }
  .lp-heading em { font-style: italic; color: var(--clr-gold-dark); }
  .lp-heading--light { color: var(--clr-white); }
  .lp-heading--light em { color: var(--clr-gold); }
  .lp-sub { font-size: var(--text-base); color: var(--clr-text-body); font-weight: 300; line-height: 1.7; }

  .lp-section { padding: var(--space-24) var(--gutter); }
  .lp-section--light { background: var(--clr-white); }
  .lp-section--off   { background: var(--clr-off-white); }
  .lp-section--dark  { background: var(--clr-navy); }

  /* Hero */
  .lp-hero {
    position: relative;
    background: linear-gradient(135deg, var(--clr-navy) 0%, #3a4037 100%);
    padding: 14rem var(--gutter) 10rem;
    text-align: center;
  }
  .lp-hero__bg {
    position: absolute; inset: 0;
    background-image: radial-gradient(rgba(206,196,167,0.1) 1px, transparent 1px);
    background-size: 32px 32px;
  }
  .lp-hero__content { position: relative; z-index: 1; max-width: 900px; margin: 0 auto; display: flex; flex-direction: column; align-items: center; gap: var(--space-6); }
  .lp-hero__heading { font-family: var(--font-heading); font-size: clamp(2rem, 5vw, 3.5rem); font-weight: 700; color: var(--clr-white); line-height: 1.1; }
  .lp-hero__heading em { font-style: italic; color: var(--clr-gold); }
  .lp-hero__sub { font-size: var(--text-lg); font-weight: 300; color: rgba(255,255,255,0.8); line-height: 1.8; max-width: 72ch; }
  .lp-hero__ctas { display: flex; gap: var(--space-4); flex-wrap: wrap; justify-content: center; }

  /* Symptoms */
  .symptoms-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: var(--space-4); margin-bottom: var(--space-8); }
  .symptom-item { display: flex; align-items: center; gap: var(--space-3); padding: var(--space-4) var(--space-5); background: var(--clr-off-white); border-radius: var(--radius-lg); border: 1px solid var(--clr-light-gray); }
  .symptom-item svg { color: var(--clr-gold-dark); flex-shrink: 0; }
  .symptom-item span { font-size: var(--text-sm); font-weight: 600; color: var(--clr-navy); }
  .misdiagnosis-box { background: var(--clr-navy); color: rgba(255,255,255,0.8); padding: var(--space-6) var(--space-8); border-radius: var(--radius-lg); font-size: var(--text-sm); font-weight: 300; line-height: 1.7; border-left: 4px solid var(--clr-gold); }
  .misdiagnosis-box strong { display: block; color: var(--clr-white); font-weight: 700; margin-bottom: var(--space-2); }

  /* Steps */
  .steps-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: var(--space-6); }
  .step-card { background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.1); border-radius: var(--radius-xl); padding: var(--space-8); }
  .step-num { display: block; font-family: var(--font-heading); font-size: 2.5rem; font-weight: 800; color: var(--clr-gold); opacity: 0.6; margin-bottom: var(--space-4); }
  .step-card h3 { font-family: var(--font-heading); font-size: var(--text-base); font-weight: 700; color: var(--clr-white); margin-bottom: var(--space-3); }
  .step-card p { font-size: var(--text-sm); color: rgba(255,255,255,0.6); line-height: 1.65; font-weight: 300; }

  /* Credentials */
  .lp-credentials { display: grid; grid-template-columns: 1fr 380px; gap: var(--space-16); align-items: center; }
  .lp-credentials__text p { font-size: var(--text-base); color: var(--clr-text-body); font-weight: 300; line-height: 1.7; margin-bottom: var(--space-5); }
  .cred-list { list-style: none; display: flex; flex-direction: column; gap: var(--space-2); }
  .cred-list li { font-size: var(--text-sm); color: var(--clr-text-mid); padding-left: var(--space-5); position: relative; }
  .cred-list li::before { content: '—'; position: absolute; left: 0; color: var(--clr-gold-dark); }
  .lp-credentials__img img { width: 100%; border-radius: var(--radius-xl); border: 2px solid var(--clr-gold); object-fit: cover; aspect-ratio: 3/4; }

  /* FAQ */
  .faq-list { max-width: 800px; margin: 0 auto; display: flex; flex-direction: column; gap: var(--space-3); }
  .faq-item { border: 1px solid var(--clr-light-gray); border-radius: var(--radius-lg); overflow: hidden; }
  .faq-item summary { padding: var(--space-5) var(--space-6); font-size: var(--text-base); font-weight: 600; color: var(--clr-navy); cursor: pointer; list-style: none; display: flex; justify-content: space-between; align-items: center; }
  .faq-item summary::-webkit-details-marker { display: none; }
  .faq-item summary::after { content: '+'; font-size: 1.4rem; color: var(--clr-gold-dark); transition: transform 0.3s ease; }
  .faq-item[open] summary::after { content: '−'; }
  .faq-item p { padding: 0 var(--space-6) var(--space-5); font-size: var(--text-sm); color: var(--clr-text-mid); line-height: 1.7; font-weight: 300; }

  /* Final CTA */
  .lp-cta { background: linear-gradient(135deg, var(--clr-navy), #3a4037); padding: var(--space-24) var(--gutter); }
  .lp-cta__inner { text-align: center; max-width: 700px; margin: 0 auto; }
  .lp-cta__inner h2 { font-family: var(--font-heading); font-size: clamp(1.8rem, 3.5vw, 2.8rem); font-weight: 700; color: var(--clr-white); line-height: 1.1; margin-bottom: var(--space-5); }
  .lp-cta__inner h2 em { font-style: italic; color: var(--clr-gold); }
  .lp-cta__inner p { font-size: var(--text-base); color: rgba(255,255,255,0.75); font-weight: 300; line-height: 1.7; margin-bottom: var(--space-8); }
  .lp-cta__btns { display: flex; gap: var(--space-4); flex-wrap: wrap; justify-content: center; }

  /* WhatsApp btn */
  .btn--whatsapp { background: #25D366; color: #fff; padding: 12px 24px; border-radius: var(--radius-pill); font-weight: 600; font-size: var(--text-xs); letter-spacing: 0.1em; text-transform: uppercase; display: inline-flex; align-items: center; transition: all 0.3s ease; }
  .btn--whatsapp:hover { background: #1ebe5d; transform: translateY(-2px); }

  @media (max-width: 1024px) {
    .steps-grid { grid-template-columns: repeat(2, 1fr); }
    .symptoms-grid { grid-template-columns: repeat(2, 1fr); }
    .lp-credentials { grid-template-columns: 1fr; }
    .lp-credentials__img { max-width: 320px; }
  }
  @media (max-width: 600px) {
    .symptoms-grid { grid-template-columns: 1fr; }
    .steps-grid { grid-template-columns: 1fr; }
    .lp-hero__ctas, .lp-cta__btns { flex-direction: column; width: 100%; }
    .btn { width: 100%; justify-content: center; }
  }
</style>
