---
import BaseLayout from '../layouts/BaseLayout.astro';
import Cursor from '../components/Cursor.astro';
import Loader from '../components/Loader.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import PatientIntent from '../components/PatientIntent.astro';
import TMJAuthority from '../components/TMJAuthority.astro';
import Training from '../components/Training.astro';
import Services from '../components/Services.astro';
import WhyDentiq from '../components/WhyDentiq.astro';
import Gallery from '../components/Gallery.astro';
import Testimonials from '../components/Testimonials.astro';
import Locations from '../components/Locations.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout>
  <Cursor />
  <Loader />
  <Nav />
  <main>
    <Hero />
    <PatientIntent />
    <TMJAuthority />
    <Training />
    <Services />
    <WhyDentiq />
    <Gallery />
    <Testimonials />
    <Locations />
    <Contact />
  </main>
  <Footer />
</BaseLayout>
