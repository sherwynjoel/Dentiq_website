---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Cursor from '../components/Cursor.astro';
import Contact from '../components/Contact.astro';

const benefits = [
  { title: "Natural Appearance", desc: "Implants look, feel and function exactly like natural teeth — no one will know the difference." },
  { title: "Permanent Solution", desc: "With proper care, dental implants last a lifetime. No need for replacements every few years." },
  { title: "Improved Chewing", desc: "Eat what you want without discomfort or restrictions — full chewing power restored." },
  { title: "Bone Preservation", desc: "Implants stimulate the jawbone and prevent the bone loss that follows tooth extraction." },
  { title: "Digital Planning", desc: "We use digital scans and 3D planning for precise implant placement and predictable outcomes." },
  { title: "No Impact on Adjacent Teeth", desc: "Unlike bridges, implants don't require grinding down neighbouring healthy teeth." }
];

const faqs = [
  { q: "Are dental implants painful?", a: "The procedure is performed under local anaesthesia. Most patients report less discomfort than a tooth extraction. Post-operative soreness is manageable with standard medication." },
  { q: "How long does the implant process take?", a: "From placement to final crown, the process typically takes 3–6 months. The implant needs to integrate with the bone before the permanent crown is fitted." },
  { q: "Who is a candidate for dental implants?", a: "Most adults with good general health and sufficient bone density are candidates. Dr. Balamurugan will assess your suitability through a clinical evaluation and imaging." },
  { q: "How long do implants last?", a: "Implants placed with proper planning and maintained with good oral hygiene can last 20–30 years or more. The crown may need replacement after 10–15 years." },
  { q: "What is the cost of dental implants in Erode?", a: "Cost varies based on the number of implants, type of crown, and any additional procedures required. We provide a transparent treatment plan with complete costs after your consultation." }
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(f => ({
    "@type": "Question",
    "name": f.q,
    "acceptedAnswer": { "@type": "Answer", "text": f.a }
  }))
};
---

<BaseLayout
  title="Dental Implants in Erode | Advanced Implant Specialist | DentiQ"
  description="Replace missing teeth with advanced dental implants in Erode. Dr. T. Balamurugan, F.I.C.O.I.(USA) — fellowship-trained implantologist. Serving Erode, Coimbatore, Salem, Tirupur, Namakkal."
  pageSchema={faqSchema}
>
  <Cursor />
  <Nav />
  <main>

    <!-- HERO -->
    <section class="lp-hero">
      <div class="lp-hero__bg"></div>
      <div class="lp-hero__content">
        <span class="section__label section__label--light">DentiQ Implant Centre · Erode</span>
        <h1 class="lp-hero__heading">Replace Missing Teeth with <em>Advanced Dental Implants</em></h1>
        <p class="lp-hero__sub">
          Permanent, natural-looking tooth replacement by Dr. T. Balamurugan, M.D.S., F.I.C.O.I.(USA) — Fellowship-trained Implantologist. Serving Erode, Coimbatore, Tirupur, Salem and Namakkal.
        </p>
        <div class="lp-hero__ctas">
          <a href="#contact" class="btn btn--primary">Book Implant Consultation</a>
          <a href="https://wa.me/918489488999" target="_blank" rel="noopener" class="btn btn--whatsapp">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" style="margin-right:6px"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413Z"/></svg>
            WhatsApp Us
          </a>
        </div>
      </div>
    </section>

    <!-- BENEFITS -->
    <section class="lp-section lp-section--light">
      <div class="lp-container">
        <div class="lp-header">
          <span class="section__label">Why Implants</span>
          <h2 class="lp-heading">Why Dental Implants Are the <em>Best Solution</em></h2>
          <p class="lp-sub">Unlike dentures or bridges, implants are a permanent, comfortable and natural-looking solution for missing teeth.</p>
        </div>
        <div class="benefits-grid">
          {benefits.map(b => (
            <div class="benefit-card">
              <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>
              <div>
                <h3>{b.title}</h3>
                <p>{b.desc}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- PROCESS -->
    <section class="lp-section lp-section--dark">
      <div class="lp-container">
        <div class="lp-header">
          <span class="section__label section__label--light">The Process</span>
          <h2 class="lp-heading lp-heading--light">Your Implant Journey — <em>Step by Step</em></h2>
        </div>
        <div class="steps-grid">
          {[
            { num: "01", title: "Consultation & Imaging", desc: "Digital scan and CBCT imaging to assess bone volume, plan placement and discuss your options." },
            { num: "02", title: "Implant Placement", desc: "Titanium implant placed under local anaesthesia. Minimally invasive and virtually painless." },
            { num: "03", title: "Healing Phase", desc: "The implant integrates with your jawbone over 2–4 months. A temporary restoration is provided." },
            { num: "04", title: "Final Crown", desc: "A custom ceramic crown is fitted — natural in colour, shape and feel. Your new smile is complete." }
          ].map(s => (
            <div class="step-card">
              <span class="step-num">{s.num}</span>
              <h3>{s.title}</h3>
              <p>{s.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="lp-section lp-section--off">
      <div class="lp-container">
        <div class="lp-header">
          <span class="section__label">Common Questions</span>
          <h2 class="lp-heading">Frequently Asked <em>Questions</em></h2>
        </div>
        <div class="faq-list">
          {faqs.map(f => (
            <details class="faq-item">
              <summary>{f.q}</summary>
              <p>{f.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="lp-cta">
      <div class="lp-container lp-cta__inner">
        <h2>Ready to Restore Your <em>Smile?</em></h2>
        <p>Book a consultation with Dr. Balamurugan and find out if dental implants are the right solution for you.</p>
        <div class="lp-cta__btns">
          <a href="#contact" class="btn btn--primary">Book Implant Consultation</a>
          <a href="https://wa.me/918489488999" target="_blank" rel="noopener" class="btn btn--whatsapp">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" style="margin-right:6px"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413Z"/></svg>
            WhatsApp
          </a>
        </div>
      </div>
    </section>

    <Contact />
  </main>
  <Footer />
</BaseLayout>

<style>
  .lp-container { max-width: var(--max-width); margin: 0 auto; padding: 0 var(--gutter); }
  .lp-header { text-align: center; margin-bottom: var(--space-12); max-width: 700px; margin-left: auto; margin-right: auto; }
  .lp-heading { font-family: var(--font-heading); font-size: clamp(1.8rem, 3vw, 2.6rem); font-weight: 700; color: var(--clr-navy); line-height: 1.15; margin-bottom: var(--space-4); }
  .lp-heading em { font-style: italic; color: var(--clr-gold-dark); }
  .lp-heading--light { color: var(--clr-white); }
  .lp-heading--light em { color: var(--clr-gold); }
  .lp-sub { font-size: var(--text-base); color: var(--clr-text-body); font-weight: 300; line-height: 1.7; }
  .lp-section { padding: var(--space-24) var(--gutter); }
  .lp-section--light { background: var(--clr-white); }
  .lp-section--off   { background: var(--clr-off-white); }
  .lp-section--dark  { background: var(--clr-navy); }

  .lp-hero { position: relative; background: linear-gradient(135deg, var(--clr-navy) 0%, #3a4037 100%); padding: 14rem var(--gutter) 10rem; text-align: center; }
  .lp-hero__bg { position: absolute; inset: 0; background-image: radial-gradient(rgba(206,196,167,0.1) 1px, transparent 1px); background-size: 32px 32px; }
  .lp-hero__content { position: relative; z-index: 1; max-width: 900px; margin: 0 auto; display: flex; flex-direction: column; align-items: center; gap: var(--space-6); }
  .lp-hero__heading { font-family: var(--font-heading); font-size: clamp(2rem, 5vw, 3.5rem); font-weight: 700; color: var(--clr-white); line-height: 1.1; }
  .lp-hero__heading em { font-style: italic; color: var(--clr-gold); }
  .lp-hero__sub { font-size: var(--text-lg); font-weight: 300; color: rgba(255,255,255,0.8); line-height: 1.8; max-width: 72ch; }
  .lp-hero__ctas { display: flex; gap: var(--space-4); flex-wrap: wrap; justify-content: center; }

  .benefits-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--space-5); }
  .benefit-card { display: flex; gap: var(--space-4); padding: var(--space-6); background: var(--clr-off-white); border-radius: var(--radius-lg); border: 1px solid var(--clr-light-gray); align-items: flex-start; transition: border-color 0.3s, box-shadow 0.3s; }
  .benefit-card:hover { border-color: var(--clr-gold); box-shadow: var(--shadow-md); }
  .benefit-card svg { color: var(--clr-gold-dark); flex-shrink: 0; margin-top: 2px; }
  .benefit-card h3 { font-size: var(--text-base); font-weight: 700; color: var(--clr-navy); margin-bottom: var(--space-2); }
  .benefit-card p { font-size: var(--text-sm); color: var(--clr-text-mid); line-height: 1.65; font-weight: 300; }

  .steps-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: var(--space-6); }
  .step-card { background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.1); border-radius: var(--radius-xl); padding: var(--space-8); }
  .step-num { display: block; font-family: var(--font-heading); font-size: 2.5rem; font-weight: 800; color: var(--clr-gold); opacity: 0.6; margin-bottom: var(--space-4); }
  .step-card h3 { font-family: var(--font-heading); font-size: var(--text-base); font-weight: 700; color: var(--clr-white); margin-bottom: var(--space-3); }
  .step-card p { font-size: var(--text-sm); color: rgba(255,255,255,0.6); line-height: 1.65; font-weight: 300; }

  .faq-list { max-width: 800px; margin: 0 auto; display: flex; flex-direction: column; gap: var(--space-3); }
  .faq-item { border: 1px solid var(--clr-light-gray); border-radius: var(--radius-lg); overflow: hidden; }
  .faq-item summary { padding: var(--space-5) var(--space-6); font-size: var(--text-base); font-weight: 600; color: var(--clr-navy); cursor: pointer; list-style: none; display: flex; justify-content: space-between; align-items: center; }
  .faq-item summary::-webkit-details-marker { display: none; }
  .faq-item summary::after { content: '+'; font-size: 1.4rem; color: var(--clr-gold-dark); }
  .faq-item[open] summary::after { content: '−'; }
  .faq-item p { padding: 0 var(--space-6) var(--space-5); font-size: var(--text-sm); color: var(--clr-text-mid); line-height: 1.7; font-weight: 300; }

  .lp-cta { background: linear-gradient(135deg, var(--clr-navy), #3a4037); padding: var(--space-24) var(--gutter); }
  .lp-cta__inner { text-align: center; max-width: 700px; margin: 0 auto; }
  .lp-cta__inner h2 { font-family: var(--font-heading); font-size: clamp(1.8rem, 3.5vw, 2.8rem); font-weight: 700; color: var(--clr-white); line-height: 1.1; margin-bottom: var(--space-5); }
  .lp-cta__inner h2 em { font-style: italic; color: var(--clr-gold); }
  .lp-cta__inner p { font-size: var(--text-base); color: rgba(255,255,255,0.75); font-weight: 300; line-height: 1.7; margin-bottom: var(--space-8); }
  .lp-cta__btns { display: flex; gap: var(--space-4); flex-wrap: wrap; justify-content: center; }

  .btn--whatsapp { background: #25D366; color: #fff; padding: 12px 24px; border-radius: var(--radius-pill); font-weight: 600; font-size: var(--text-xs); letter-spacing: 0.1em; text-transform: uppercase; display: inline-flex; align-items: center; transition: all 0.3s ease; }
  .btn--whatsapp:hover { background: #1ebe5d; transform: translateY(-2px); }

  @media (max-width: 1024px) { .steps-grid { grid-template-columns: repeat(2, 1fr); } .benefits-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 600px) { .benefits-grid { grid-template-columns: 1fr; } .steps-grid { grid-template-columns: 1fr; } .lp-hero__ctas, .lp-cta__btns { flex-direction: column; width: 100%; } .btn { width: 100%; justify-content: center; } }
</style>
