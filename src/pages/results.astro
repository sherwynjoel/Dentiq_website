---

<BaseLayout
  title="Patient Results & Smile Transformations | DentiQ Superspeciality Erode"
  description="See real before and after results from DentiQ Superspeciality Laser Dental Hospital in Erode."
>
  <Cursor />
  <Nav />

  <main>
    <!-- HERO -->
    <section class="results-hero">
      <div class="results-hero__bg"></div>
      <div class="results-hero__content">
        <span class="section__label section__label--light">Real Patients. Real Results.</span>
        <h1 class="results-hero__heading">Smile Transformations That <em>Speak for Themselves</em></h1>
        <p class="results-hero__sub">
          Every case in our gallery belongs to a real DentiQ patient — life-changing results our superspecialists deliver every day in Erode.
        </p>
        <div class="results-hero__ctas">
          <a href="#cases" class="btn btn--primary">See the Results</a>
          <a href="#contact" class="btn btn--outline">Book Your Consultation</a>
        </div>
      </div>
    </section>

    <!-- GALLERY -->
    <section id="cases" class="cases section">
      <div class="container">
        <div class="section-header">
          <span class="section__label">Transformations</span>
          <h2 class="section__heading">Before &amp; After <em>Gallery</em></h2>
          <p class="section-sub">Real results across all 10 treatment specialities at DentiQ Erode.</p>
        </div>

        <!-- Filter tabs -->
        <div class="filters">
          {categories.map((cat, i) => (
            <button class={`filter-btn${i === 0 ? ' active' : ''}`} data-cat={cat}>{cat}</button>
          ))}
        </div>

        <p class="results-count"><span id="visible-count">{cases.length}</span> cases</p>

        <div class="cases__grid" id="cases-grid">
          {cases.map((item) => (
            <div class="case-card" data-cat={item.category}>
              <div class="case-card__img-box">
                {item.single ? (
                  <div class="single-img">
                    <img src={item.before} alt={item.title} loading="lazy" />
                    <div class="case-card__overlay">
                      <span class="case-card__tag">{item.tag}</span>
                    </div>
                  </div>
                ) : (
                  <div class="before-after">
                    <div class="before-after__half">
                      <img src={item.before} alt={`Before — ${item.title}`} loading="lazy" />
                      <span class="ba-label ba-label--before">Before</span>
                    </div>
                    <div class="before-after__divider"></div>
                    <div class="before-after__half">
                      <img src={item.after} alt={`After — ${item.title}`} loading="lazy" />
                      <span class="ba-label ba-label--after">After</span>
                    </div>
                    <div class="case-card__overlay">
                      <span class="case-card__tag">{item.tag}</span>
                    </div>
                  </div>
                )}
              </div>
              <div class="case-card__content">
                <span class="case-card__category">{item.category}</span>
                <h3 class="case-card__title">{item.title}</h3>
                <p class="case-card__desc">{item.desc}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <Contact />
  </main>

  <Footer />
</BaseLayout>

<style>
  .container { max-width: var(--max-width); margin: 0 auto; padding: 0 var(--gutter); }
  .section-header { text-align: center; margin-bottom: var(--space-10); max-width: 800px; margin-left: auto; margin-right: auto; }
  .section__heading { font-family: var(--font-heading); font-size: var(--text-3xl); margin-bottom: var(--space-6); color: inherit; line-height: 1.1; }
  .section__heading em { font-style: italic; color: var(--clr-gold-dark); }
  .section-sub { font-size: var(--text-lg); opacity: 0.8; font-weight: 300; color: inherit; line-height: 1.6; }

  /* Hero */
  .results-hero {
    position: relative;
    background: linear-gradient(135deg, var(--clr-navy) 0%, #3a4037 100%);
    padding: 14rem var(--gutter) 12rem;
    text-align: center;
  }
  .results-hero__bg { position: absolute; inset: 0; background-image: radial-gradient(rgba(206,196,167,0.1) 1px, transparent 1px); background-size: 32px 32px; }
  .results-hero__content { position: relative; z-index: 1; max-width: 900px; margin: 0 auto; display: flex; flex-direction: column; align-items: center; gap: var(--space-6); }
  .results-hero__heading { font-family: var(--font-heading); font-size: clamp(2.5rem, 6vw, 4rem); font-weight: 600; color: var(--clr-white); line-height: 1.1; }
  .results-hero__heading em { color: var(--clr-gold); font-style: italic; }
  .results-hero__sub { font-size: var(--text-lg); font-weight: 300; color: rgba(255,255,255,0.8); line-height: 1.8; max-width: 68ch; }
  .results-hero__ctas { display: flex; gap: var(--space-4); flex-wrap: wrap; justify-content: center; }

  /* Filters */
  .filters { display: flex; gap: var(--space-2); flex-wrap: wrap; justify-content: center; margin-bottom: var(--space-4); }
  .filter-btn {
    padding: var(--space-2) var(--space-5); border-radius: var(--radius-pill);
    border: 1.5px solid var(--clr-light-gray); background: var(--clr-white);
    color: var(--clr-text-mid); font-size: var(--text-sm); font-weight: 600;
    cursor: pointer; transition: all 0.2s ease; font-family: var(--font-body);
  }
  .filter-btn:hover { border-color: var(--clr-gold); color: var(--clr-navy); }
  .filter-btn.active { background: var(--clr-navy); color: var(--clr-gold); border-color: var(--clr-navy); }

  .results-count { text-align: center; font-size: var(--text-sm); color: var(--clr-text-mid); margin-bottom: var(--space-10); font-weight: 300; }

  /* Grid */
  .cases__grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--space-8); }
  .case-card {
    background: var(--clr-white); border-radius: var(--radius-xl); overflow: hidden;
    border: 1px solid var(--clr-light-gray);
    transition: transform 0.4s var(--ease-out-expo), box-shadow 0.4s ease, border-color 0.3s ease;
  }
  .case-card.hidden { display: none; }
  .case-card:hover { transform: translateY(-8px); box-shadow: var(--shadow-lg); border-color: var(--clr-gold); }

  .case-card__img-box { position: relative; aspect-ratio: 4/3; overflow: hidden; background: var(--clr-off-white); }

  /* Before/After */
  .before-after { position: absolute; inset: 0; display: flex; }
  .before-after__half { position: relative; flex: 1; overflow: hidden; }
  .before-after__half img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.7s ease; }
  .case-card:hover .before-after__half img { transform: scale(1.06); }
  .before-after__divider { width: 2px; background: rgba(255,255,255,0.7); z-index: 3; flex-shrink: 0; }

  /* Single image */
  .single-img { position: absolute; inset: 0; }
  .single-img img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.7s ease; }
  .case-card:hover .single-img img { transform: scale(1.06); }

  .ba-label {
    position: absolute; top: var(--space-3); left: 50%; transform: translateX(-50%);
    background: rgba(0,0,0,0.55); color: #fff; font-size: 0.6rem; font-weight: 700;
    text-transform: uppercase; letter-spacing: 0.14em; padding: 3px 8px;
    border-radius: var(--radius-pill); backdrop-filter: blur(4px); white-space: nowrap; z-index: 4;
  }
  .case-card__overlay {
    position: absolute; inset: 0; background: linear-gradient(to top, rgba(45,53,42,0.45), transparent 60%);
    display: flex; align-items: flex-end; padding: var(--space-4); z-index: 2; pointer-events: none;
  }
  .case-card__tag {
    background: var(--clr-gold); color: var(--clr-navy); padding: 5px 14px;
    border-radius: var(--radius-pill); font-size: 0.65rem; font-weight: 700;
    text-transform: uppercase; letter-spacing: 0.1em;
  }

  .case-card__content { padding: var(--space-6) var(--space-8) var(--space-8); }
  .case-card__category { display: block; font-size: 0.65rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.15em; color: var(--clr-gold-dark); margin-bottom: var(--space-2); }
  .case-card__title { font-family: var(--font-heading); font-size: var(--text-lg); font-weight: 600; color: var(--clr-navy); margin-bottom: var(--space-3); }
  .case-card__desc { font-size: var(--text-sm); line-height: 1.7; color: var(--clr-text-mid); font-weight: 300; }

  @media (max-width: 1100px) { .cases__grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 640px) {
    .cases__grid { grid-template-columns: 1fr; }
    .results-hero__ctas { flex-direction: column; width: 100%; }
    .btn { width: 100%; }
    .filters { gap: var(--space-2); }
    .filter-btn { font-size: 0.7rem; padding: var(--space-1) var(--space-3); }
  }
</style>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);

  gsap.from('.results-hero__content > *', { y: 24, opacity: 0, stagger: 0.1, duration: 0.7, ease: 'power2.out' });
  gsap.from('.case-card', {
    scrollTrigger: { trigger: '.cases__grid', start: 'top 85%' },
    y: 40, opacity: 0, stagger: 0.06, duration: 0.9, ease: 'power3.out'
  });

  const filterBtns = document.querySelectorAll<HTMLButtonElement>('.filter-btn');
  const cards = document.querySelectorAll<HTMLElement>('.case-card');
  const countEl = document.getElementById('visible-count');

  filterBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      filterBtns.forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      const selected = btn.dataset.cat;
      let visible = 0;
      cards.forEach(card => {
        const match = selected === 'All' || card.dataset.cat === selected;
        card.classList.toggle('hidden', !match);
        if (match) visible++;
      });
      if (countEl) countEl.textContent = String(visible);
    });
  });
</script>
