---

<BaseLayout
  title="Patient Results & Smile Transformations | DentiQ Superspeciality Erode"
  description="See real before and after results from DentiQ Superspeciality Laser Dental Hospital in Erode."
>
  <Cursor />
  <Nav />

  <main>
    <!-- HERO -->
    <section class="results-hero">
      <div class="results-hero__bg"></div>
      <div class="results-hero__content">
        <span class="section__label section__label--light">Real Patients. Real Results.</span>
        <h1 class="results-hero__heading">Smile Transformations That <em>Speak for Themselves</em></h1>
        <p class="results-hero__sub">
          Every case in our gallery belongs to a real DentiQ patient — life-changing results our superspecialists deliver every day in Erode.
        </p>
        <div class="results-hero__ctas">
          <a href="#cases" class="btn btn--primary">See the Results</a>
          <a href="#contact" class="btn btn--outline">Book Your Consultation</a>
        </div>
      </div>
    </section>

    <!-- GALLERY -->
    <section id="cases" class="cases section">
      <div class="container">
        <div class="section-header">
          <span class="section__label">Transformations</span>
          <h2 class="section__heading">Before &amp; After <em>Gallery</em></h2>
          <p class="section-sub">Real results across all 10 treatment specialities at DentiQ Erode.</p>
        </div>

        <!-- Filter tabs -->
        <div class="filters">
          {categories.map((cat, i) => (
            <button class={`filter-btn${i === 0 ? ' active' : ''}`} data-cat={cat}>{cat}</button>
          ))}
        </div>

        <p class="results-count"><span id="visible-count">{cases.length}</span> cases</p>

        <div class="cases__grid" id="cases-grid">
          {cases.map((item, i) => (
            <div
              class="case-card"
              data-cat={item.category}
              data-index={String(i)}
              data-before={item.before}
              data-after={item.after || ''}
              data-title={item.title}
              data-desc={item.desc}
              data-tag={item.tag}
              data-single={item.single ? 'true' : 'false'}
            >
              <div class="case-card__img">
                <img class="card-img card-img--before" src={item.before} alt={item.title} loading="lazy" />
                {!item.single && <img class="card-img card-img--after" src={item.after} alt={`After — ${item.title}`} loading="lazy" />}
                <div class="case-card__overlay">
                  <div class="case-card__overlay-top">
                    <span class="case-cat">{item.category}</span>
                    {!item.single && <span class="case-ba-label"><span class="ba-before-lbl">Before</span><span class="ba-after-lbl">After</span></span>}
                  </div>
                </div>
              </div>
              <div class="case-card__body">
                <h3 class="case-title">{item.title}</h3>
                <p class="case-desc">{item.desc}</p>
                {!item.single && (
                  <span class="case-view">
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="M21 21l-4.35-4.35"/></svg>
                    Click to view full result
                  </span>
                )}
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- LIGHTBOX -->
    <div class="lightbox" id="lightbox" role="dialog" aria-modal="true" aria-hidden="true">
      <button class="lb-close" id="lb-close" aria-label="Close">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M18 6L6 18M6 6l12 12"/></svg>
      </button>
      <button class="lb-nav lb-prev" id="lb-prev" aria-label="Previous">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M15 18l-6-6 6-6"/></svg>
      </button>
      <button class="lb-nav lb-next" id="lb-next" aria-label="Next">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M9 18l6-6-6-6"/></svg>
      </button>
      <div class="lb-content">
        <div class="lb-images" id="lb-images">
          <div class="lb-panel">
            <img id="lb-before-img" src="" alt="" />
            <span class="lb-img-label">Before</span>
          </div>
          <div class="lb-panel" id="lb-after-panel">
            <img id="lb-after-img" src="" alt="" />
            <span class="lb-img-label lb-img-label--gold">After</span>
          </div>
        </div>
        <div class="lb-info">
          <span id="lb-cat" class="lb-cat"></span>
          <h2 id="lb-title" class="lb-title"></h2>
          <p id="lb-desc" class="lb-desc"></p>
          <span id="lb-count" class="lb-count"></span>
        </div>
      </div>
    </div>

    <Contact />
  </main>

  <Footer />
</BaseLayout>

<style>
  .container { max-width: var(--max-width); margin: 0 auto; padding: 0 var(--gutter); }
  .section-header { text-align: center; margin-bottom: var(--space-10); max-width: 800px; margin-left: auto; margin-right: auto; }
  .section__heading { font-family: var(--font-heading); font-size: var(--text-3xl); margin-bottom: var(--space-6); color: inherit; line-height: 1.1; }
  .section__heading em { font-style: italic; color: var(--clr-gold-dark); }
  .section-sub { font-size: var(--text-lg); opacity: 0.8; font-weight: 300; color: inherit; line-height: 1.6; }

  /* Hero */
  .results-hero {
    position: relative;
    background: linear-gradient(135deg, var(--clr-navy) 0%, #3a4037 100%);
    padding: 14rem var(--gutter) 12rem;
    text-align: center;
  }
  .results-hero__bg { position: absolute; inset: 0; background-image: radial-gradient(rgba(206,196,167,0.1) 1px, transparent 1px); background-size: 32px 32px; }
  .results-hero__content { position: relative; z-index: 1; max-width: 900px; margin: 0 auto; display: flex; flex-direction: column; align-items: center; gap: var(--space-6); }
  .results-hero__heading { font-family: var(--font-heading); font-size: clamp(2.5rem, 6vw, 4rem); font-weight: 600; color: var(--clr-white); line-height: 1.1; }
  .results-hero__heading em { color: var(--clr-gold); font-style: italic; }
  .results-hero__sub { font-size: var(--text-lg); font-weight: 300; color: rgba(255,255,255,0.8); line-height: 1.8; max-width: 68ch; }
  .results-hero__ctas { display: flex; gap: var(--space-4); flex-wrap: wrap; justify-content: center; }

  /* Filters */
  .filters { display: flex; gap: var(--space-2); flex-wrap: wrap; justify-content: center; margin-bottom: var(--space-4); }
  .filter-btn {
    padding: var(--space-2) var(--space-5); border-radius: var(--radius-pill);
    border: 1.5px solid var(--clr-light-gray); background: var(--clr-white);
    color: var(--clr-text-mid); font-size: var(--text-sm); font-weight: 600;
    cursor: pointer; transition: all 0.2s ease; font-family: var(--font-body);
  }
  .filter-btn:hover { border-color: var(--clr-gold); color: var(--clr-navy); }
  .filter-btn.active { background: var(--clr-navy); color: var(--clr-gold); border-color: var(--clr-navy); }

  .results-count { text-align: center; font-size: var(--text-sm); color: var(--clr-text-mid); margin-bottom: var(--space-10); font-weight: 300; }

  /* ── Thumbnail Grid ── */
  .cases__grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--space-4); }

  .case-card {
    border-radius: var(--radius-lg); overflow: hidden;
    cursor: pointer;
    background: var(--clr-white);
    border: 1px solid var(--clr-light-gray);
    transition: transform 0.35s var(--ease-out-expo), box-shadow 0.35s ease, border-color 0.25s ease;
  }
  .case-card.hidden { display: none; }
  .case-card:hover { transform: translateY(-5px); box-shadow: var(--shadow-lg); border-color: var(--clr-gold); }

  .case-card__img {
    position: relative; aspect-ratio: 4/3; overflow: hidden;
  }

  .card-img {
    position: absolute; inset: 0;
    width: 100%; height: 100%; object-fit: cover; display: block;
    transition: opacity 0.9s ease, transform 0.6s ease;
  }
  .card-img--before { opacity: 1; }
  .card-img--after  { opacity: 0; }
  .case-card.show-after .card-img--before { opacity: 0; }
  .case-card.show-after .card-img--after  { opacity: 1; }
  .case-card:hover .card-img { transform: scale(1.06); }

  .case-card__overlay {
    position: absolute; inset: 0;
    background: linear-gradient(to top, rgba(20,25,18,0.5) 0%, transparent 50%);
    display: flex; flex-direction: column;
    justify-content: space-between;
    padding: var(--space-4);
  }

  .case-card__body {
    padding: var(--space-4) var(--space-5) var(--space-5);
    background: var(--clr-white);
  }

  .case-card__overlay-top { display: flex; justify-content: space-between; align-items: center; }

  .case-ba-label {
    font-size: 0.58rem; font-weight: 700; text-transform: uppercase;
    letter-spacing: 0.14em; padding: 4px 10px;
    border-radius: var(--radius-pill); backdrop-filter: blur(6px);
    background: rgba(0,0,0,0.45);
  }
  .ba-before-lbl { color: rgba(255,255,255,0.85); display: inline; }
  .ba-after-lbl  { color: var(--clr-gold); display: none; }
  .case-card.show-after .ba-before-lbl { display: none; }
  .case-card.show-after .ba-after-lbl  { display: inline; }

  .case-cat {
    display: inline-block;
    font-size: 0.55rem; font-weight: 700; text-transform: uppercase;
    letter-spacing: 0.12em; color: rgba(255,255,255,0.85);
    background: rgba(0,0,0,0.45); padding: 4px 10px;
    border-radius: var(--radius-pill); backdrop-filter: blur(6px);
  }

  .case-title {
    font-family: var(--font-heading); font-size: var(--text-base);
    font-weight: 700; color: var(--clr-navy); line-height: 1.2;
    margin-bottom: var(--space-2);
  }
  .case-desc {
    font-size: var(--text-sm); color: var(--clr-text-mid);
    font-weight: 300; line-height: 1.6;
    margin-bottom: var(--space-3);
  }
  .case-view {
    display: inline-flex; align-items: center; gap: 5px;
    font-size: 0.6rem; font-weight: 700; text-transform: uppercase;
    letter-spacing: 0.1em; color: var(--clr-gold-dark);
    transition: gap 0.2s ease;
  }
  .case-card:hover .case-view { gap: 8px; }

  /* ── Lightbox ── */
  .lightbox {
    position: fixed; inset: 0; z-index: 9999;
    background: rgba(8,10,8,0.96);
    display: flex; align-items: center; justify-content: center;
    padding: clamp(1rem, 4vw, 3rem);
    opacity: 0; pointer-events: none;
    transition: opacity 0.3s ease;
  }
  .lightbox.is-open { opacity: 1; pointer-events: all; }

  .lb-close {
    position: absolute; top: var(--space-5); right: var(--space-5);
    width: 44px; height: 44px; border-radius: 50%;
    background: rgba(255,255,255,0.1); color: white;
    border: 1px solid rgba(255,255,255,0.2);
    display: flex; align-items: center; justify-content: center;
    cursor: pointer; transition: background 0.2s ease; z-index: 2;
  }
  .lb-close:hover { background: rgba(255,255,255,0.22); }

  .lb-nav {
    position: absolute; top: 50%; transform: translateY(-50%);
    width: 52px; height: 52px; border-radius: 50%;
    background: rgba(255,255,255,0.08); color: white;
    border: 1px solid rgba(255,255,255,0.15);
    display: flex; align-items: center; justify-content: center;
    cursor: pointer; transition: background 0.2s ease, transform 0.2s ease; z-index: 2;
  }
  .lb-nav:hover { background: rgba(255,255,255,0.18); }
  .lb-prev { left: var(--space-5); }
  .lb-next { right: var(--space-5); }
  .lb-prev:hover { transform: translateY(-50%) translateX(-2px); }
  .lb-next:hover { transform: translateY(-50%) translateX(2px); }

  .lb-content {
    max-width: 1080px; width: 100%;
    display: flex; flex-direction: column; gap: var(--space-5);
  }

  .lb-images {
    display: grid; grid-template-columns: 1fr 1fr;
    gap: var(--space-3);
  }
  .lb-images.lb-single { grid-template-columns: 1fr; max-width: 560px; margin: 0 auto; width: 100%; }

  .lb-panel {
    position: relative;
    aspect-ratio: 4 / 3;
    border-radius: var(--radius-lg); overflow: hidden;
    border: 1px solid rgba(206,196,167,0.2);
  }
  .lb-panel img {
    position: absolute; inset: 0;
    width: 100%; height: 100%; object-fit: cover; display: block;
  }

  .lb-img-label {
    position: absolute; top: var(--space-3); left: var(--space-3);
    background: rgba(0,0,0,0.6); color: white;
    font-size: 0.6rem; font-weight: 700; text-transform: uppercase;
    letter-spacing: 0.14em; padding: 5px 12px;
    border-radius: var(--radius-pill); backdrop-filter: blur(8px);
  }
  .lb-img-label--gold { background: var(--clr-gold); color: var(--clr-navy); }

  .lb-info { text-align: center; }
  .lb-cat {
    display: block; font-size: 0.62rem; font-weight: 700;
    text-transform: uppercase; letter-spacing: 0.16em;
    color: var(--clr-gold); margin-bottom: var(--space-2);
  }
  .lb-title {
    font-family: var(--font-heading); font-size: var(--text-xl);
    font-weight: 700; color: white; margin-bottom: var(--space-3);
  }
  .lb-desc {
    font-size: var(--text-sm); color: rgba(255,255,255,0.6);
    font-weight: 300; line-height: 1.7;
    max-width: 68ch; margin: 0 auto var(--space-3);
  }
  .lb-count {
    font-size: 0.62rem; color: rgba(255,255,255,0.3);
    letter-spacing: 0.1em; font-weight: 500;
  }

  @media (max-width: 1100px) { .cases__grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 640px) {
    .cases__grid { grid-template-columns: repeat(2, 1fr); gap: var(--space-2); }
    .lb-images { grid-template-columns: 1fr; height: auto; }
    .lb-panel { height: 200px; }
    .results-hero__ctas { flex-direction: column; width: 100%; }
    .filters { gap: var(--space-2); }
    .filter-btn { font-size: 0.7rem; padding: var(--space-1) var(--space-3); }
  }
</style>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);

  gsap.from('.results-hero__content > *', { y: 24, opacity: 0, stagger: 0.1, duration: 0.7, ease: 'power2.out' });
  gsap.from('.case-card', {
    scrollTrigger: { trigger: '.cases__grid', start: 'top 85%' },
    y: 40, opacity: 0, stagger: 0.06, duration: 0.9, ease: 'power3.out'
  });

  // ── Auto-cycle Before/After every 2s ──
  setInterval(() => {
    document.querySelectorAll<HTMLElement>('.case-card:not([data-single="true"]):not(.hidden)')
      .forEach(card => card.classList.toggle('show-after'));
  }, 2000);

  // ── Lightbox ──
  const lightbox     = document.getElementById('lightbox')!;
  const lbBeforeImg  = document.getElementById('lb-before-img')  as HTMLImageElement;
  const lbAfterImg   = document.getElementById('lb-after-img')   as HTMLImageElement;
  const lbAfterPanel = document.getElementById('lb-after-panel') as HTMLElement;
  const lbImages     = document.getElementById('lb-images')      as HTMLElement;
  const lbCatEl      = document.getElementById('lb-cat')!;
  const lbTitleEl    = document.getElementById('lb-title')!;
  const lbDescEl     = document.getElementById('lb-desc')!;
  const lbCountEl    = document.getElementById('lb-count')!;

  let currentIdx = 0;
  let visibleIdxs: number[] = [];

  const getVisible = () =>
    Array.from(document.querySelectorAll<HTMLElement>('.case-card:not(.hidden)'))
      .map(c => parseInt(c.dataset.index || '0'));

  const showCase = (dataIdx: number) => {
    const card = document.querySelector<HTMLElement>(`.case-card[data-index="${dataIdx}"]`)!;
    const isSingle = card.dataset.single === 'true';
    lbBeforeImg.src = card.dataset.before!;
    lbBeforeImg.alt = card.dataset.title!;
    lbAfterImg.src  = card.dataset.after!;
    lbAfterImg.alt  = card.dataset.title!;
    lbAfterPanel.style.display = isSingle ? 'none' : '';
    lbImages.className = isSingle ? 'lb-images lb-single' : 'lb-images';
    lbCatEl.textContent   = card.dataset.cat!;
    lbTitleEl.textContent = card.dataset.title!;
    lbDescEl.textContent  = card.dataset.desc!;
    const pos = visibleIdxs.indexOf(dataIdx);
    lbCountEl.textContent = `${pos + 1} / ${visibleIdxs.length}`;
  };

  const openLightbox = (dataIdx: number) => {
    visibleIdxs = getVisible();
    currentIdx  = visibleIdxs.indexOf(dataIdx);
    showCase(dataIdx);
    lightbox.classList.add('is-open');
    lightbox.setAttribute('aria-hidden', 'false');
    document.body.style.overflow = 'hidden';
  };

  const closeLightbox = () => {
    lightbox.classList.remove('is-open');
    lightbox.setAttribute('aria-hidden', 'true');
    document.body.style.overflow = '';
  };

  const navigate = (dir: 1 | -1) => {
    currentIdx = (currentIdx + dir + visibleIdxs.length) % visibleIdxs.length;
    showCase(visibleIdxs[currentIdx]);
  };

  document.querySelectorAll<HTMLElement>('.case-card').forEach(card => {
    card.addEventListener('click', () => openLightbox(parseInt(card.dataset.index || '0')));
  });
  document.getElementById('lb-close')!.addEventListener('click', closeLightbox);
  document.getElementById('lb-prev')!.addEventListener('click',  () => navigate(-1));
  document.getElementById('lb-next')!.addEventListener('click',  () => navigate(1));
  lightbox.addEventListener('click', (e) => { if (e.target === lightbox) closeLightbox(); });
  document.addEventListener('keydown', (e) => {
    if (!lightbox.classList.contains('is-open')) return;
    if (e.key === 'Escape')      closeLightbox();
    if (e.key === 'ArrowLeft')   navigate(-1);
    if (e.key === 'ArrowRight')  navigate(1);
  });

  const filterBtns = document.querySelectorAll<HTMLButtonElement>('.filter-btn');
  const cards = document.querySelectorAll<HTMLElement>('.case-card');
  const countEl = document.getElementById('visible-count');

  filterBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      filterBtns.forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      const selected = btn.dataset.cat;
      let visible = 0;
      cards.forEach(card => {
        const match = selected === 'All' || card.dataset.cat === selected;
        card.classList.toggle('hidden', !match);
if (match) visible++;
      });
      if (countEl) countEl.textContent = String(visible);
    });
  });
</script>
